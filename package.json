{
  "name": "wrocpp-github-io",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Wroclaw C++ community hub — blog, events, resources.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "python3 scripts/check-llms-sync.py && python3 scripts/check-pubdates.py && python3 scripts/prose-lint.py --all --strict && npm run check:future",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:llms-sync": "python3 scripts/check-llms-sync.py",
    "check:prose": "python3 scripts/prose-lint.py --all --strict",
    "check:pubdates": "python3 scripts/check-pubdates.py",
    "check:cards": "python3 scripts/check-social-render.py --all",
    "check:future": "WROCPP_RENDER_ALL=1 astro build --outDir dist-preflight",
    "check:volatile": "python3 scripts/check-volatile-claims.py --days 14"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.0",
    "js-yaml": "^5.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "yaml": "^2.8.3"
  }
}
